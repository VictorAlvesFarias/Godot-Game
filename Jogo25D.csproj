<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Jogo25D</RootNamespace>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <GodotExePath Condition=" '$(GodotExePath)' == '' ">
		E:\Programs\Godot\Godot_v4.6-stable_mono_win64_console.exe
	</GodotExePath>
    <RunCommand>powershell</RunCommand>
    <RunArguments>
      -NoExit -Command "dotnet build '$(MSBuildProjectDirectory)\$(MSBuildProjectFile)' ; Start-Process -FilePath '$(GodotExePath)' -ArgumentList '--path','$(MSBuildProjectDirectory)' -NoNewWindow"
    </RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Scenes\Characters\**" />
    <Compile Remove="Scenes\Entities\**" />
    <Compile Remove="Scenes\Levels\**" />
    <EmbeddedResource Remove="Scenes\Characters\**" />
    <EmbeddedResource Remove="Scenes\Entities\**" />
    <EmbeddedResource Remove="Scenes\Levels\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Textures\Screenshot 2026-02-21 014440.png" />
    <Content Include="Assets\Textures\Screenshot 2026-02-21 014543.png" />
    <Content Include="Assets\Textures\Untitled.png" />
    <Content Include="Assets\Tiles\TX Chest Animation.png" />
    <Content Include="Assets\Tiles\TX FX Flame.png" />
    <Content Include="Assets\Tiles\TX FX Torch Flame.png" />
    <Content Include="Assets\Tiles\TX Tileset Ground.png" />
    <Content Include="Assets\Tiles\TX Village Props.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".gitignore" />
    <None Include="Assets\Audio\Music\.gitkeep" />
    <None Include="Assets\Audio\SFX\.gitkeep" />
    <None Include="Assets\Fonts\.gitkeep" />
    <None Include="Assets\Sprites\.gitkeep" />
    <None Include="Assets\Textures\.gitkeep" />
    <None Include="Assets\Textures\Screenshot 2026-02-21 014440.png.import" />
    <None Include="Assets\Textures\Screenshot 2026-02-21 014543.png.import" />
    <None Include="Jogo25D.sln" />

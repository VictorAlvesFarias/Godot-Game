flowchart TD
    classDef ui fill:#e8f0fe,stroke:#4285f4,color:#111
    classDef mgr fill:#e6f4ea,stroke:#34a853,color:#111
    classDef ev fill:#fff3cd,stroke:#f9ab00,color:#111
    classDef srv fill:#fce8e6,stroke:#ea4335,color:#111

    subgraph CLIENTE
        MU["MultiplayerUI"]:::ui
        CS["CharacterSelectUI"]:::ui
        RT["RouterManager"]:::mgr
        NE["NetworkManager (cliente)"]:::mgr
        SEc["SessionManager (cliente)"]:::mgr
    end

    subgraph SERVIDOR
        SEs["SessionManager (host)"]:::srv
        SAs["SaveManager (host)"]:::srv
        FPJ["FinishPeerJoin(peerId, character)"]:::srv
        DIs["DimensionManager (host)"]:::srv
        CHs["ChunkStreamingManager (host)"]:::srv
    end

    MU -->|"1 SpawnWorldAndJoin(endereco)"| SEc
    SEc -->|"2 JoinServer(endereco)"| NE
    NE -.->|"3 ConnectionSucceeded"| SEc
    NE -.->|"3 ConnectionSucceeded"| MU
    MU -->|"StopWaitingForConnection<br/>(nao fecha a tela)"| MU

    SEc -->|"4 RequestJoinInfo<br/>RpcId(1, RequestJoinInfoServerReceive)"| SEs
    SEs -->|"5 RpcId(peer, JoinInfoReceive, CharacterMode)"| SEc

    SEc -->|"6a modo LocalCharacters"| EV["CharacterSelectionRequired<br/>(contexto, chave, resumos)"]:::ev
    SEc -->|"6b modo ServerCharacters<br/>RpcId(1, RequestServerCharacterListServerReceive, profileId)"| SEs
    SEs -->|"7 LoadServerCharacters"| SAs
    SEs -->|"8 RpcId(peer, ServerCharacterListReceive, summaries)"| SEc
    SEc --> EV

    EV -.->|"9 assinado por"| MU
    MU -->|"10 seta contexto + Open(CharacterSelectUI)"| RT
    RT -->|"11 fecha MultiplayerUI, abre"| CS

    CS -->|"12 SelectCharacter(character)"| SEc
    SEc -->|"IsConnected() -> SubmitLocalCharacterForJoin"| SEc

    SEc -->|"13a RpcId(1, SubmitLocalCharacterServerReceive)"| A1["_peerCharacters[peer] = character"]:::srv
    SEc -->|"13b RpcId(1, SelectServerCharacterServerReceive, characterId)<br/>SaveManager.LoadServerCharacter"| A2["_peerCharacters[peer] = character"]:::srv
    SEc -->|"13c RpcId(1, CreateServerCharacterServerReceive, name)<br/>SaveManager.CreateServerCharacter"| A3["_peerCharacters[peer] = character"]:::srv

    A1 --> FPJ
    A2 --> FPJ
    A3 --> FPJ

    FPJ -->|"Player.tscn.Instantiate, Data = character.Data.Duplicate"| P1["Player do peer"]
    FPJ -->|"PreloadSpawnAreaAsync + CatchUpPeer(id)"| CHs
    FPJ -->|"RpcId(peer, ClearLayersReceive)<br/>FindGroundSpawnPosition"| DIs
    FPJ -->|"SpawnPlayer + SpawnPlayerRequest"| DIs
    FPJ -->|"replica players existentes, NPC_Dummy, WorldItems pro peer"| DIs

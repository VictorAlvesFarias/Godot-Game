<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Launcher</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Localiza a instalação do Visual Studio via vswhere (caminho fixo do
       instalador), já que a instalação em si pode estar em qualquer lugar
       (aqui está fora do padrão, em E:\Tmp\...). Usado só pra referenciar
       os assemblies de automação EnvDTE, que permitem o Launcher pedir pro
       próprio VS anexar o debugger no processo do Godot que ele sobe. -->
  <!-- Referências adicionadas em tempo de execução (não de avaliação),
       porque o caminho do VS só é conhecido depois de rodar o vswhere. -->
  <Target Name="LocateVisualStudio" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Exec Command="&quot;%25ProgramFiles(x86)%25\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -property installationPath"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          Condition="'$(VsInstallDir)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsInstallDir" />
    </Exec>

    <ItemGroup Condition="'$(VsInstallDir)' != ''">
      <Reference Include="EnvDTE">
        <HintPath>$(VsInstallDir)\Common7\IDE\PublicAssemblies\envdte.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="EnvDTE80">
        <HintPath>$(VsInstallDir)\Common7\IDE\PublicAssemblies\envdte80.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.Interop">
        <HintPath>$(VsInstallDir)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Game\Game.csproj" />
  </ItemGroup>
</Project>
